# ================================================================
#  Academic Portal — Environment Configuration
#  Copy this file to .env and fill in your own values.
#  (setup.bat will do this automatically on first run)
# ================================================================

# ----------------------------------------------------------------
# EMAIL CONFIGURATION (Required for OTP login/registration emails)
# ----------------------------------------------------------------
# Use your Gmail address.
# For the password, you CANNOT use your normal Gmail password.
# You must create a Gmail "App Password":
#
#   Step 1: Go to https://myaccount.google.com/security
#   Step 2: Enable "2-Step Verification" if not already enabled
#   Step 3: Go to "App Passwords" (search for it in the search bar)
#   Step 4: Select app = "Mail", device = "Windows Computer"
#   Step 5: Click Generate — you will get a 16-character code
#   Step 6: Paste that 16-character code below (no spaces)
#
# If you skip this, the system will still work but OTP emails
# will not be sent (login/registration requiring email will fail).
# ----------------------------------------------------------------

EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
